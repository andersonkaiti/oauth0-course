{
  "$schema": "https://www.schemastore.org/tsconfig",
  "_version": "24.0.0",

  "compilerOptions": {
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "nodenext",
    "target": "es2024",
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",

    "allowImportingTsExtensions": true,
    "noEmit": true,

    "paths": {
      "@/*": ["./src/*"],
      "@errors/*": ["./src/application/errors/*"],
      "@gateways/*": ["./src/application/gateways/*"],
      "@use-cases/*": ["./src/application/use-cases/*"],
      "@domain/*": ["./src/domain/*"],
      "@database/*": ["./src/infra/database/*"],
      "@factories/*": ["./src/infra/http/factories/*"],
      "@routes/*": ["./src/infra/http/routes/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
